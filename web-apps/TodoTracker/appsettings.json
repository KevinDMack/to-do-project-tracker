{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "__PLACEHOLDER_DOMAIN__",
    "TenantId": "__PLACEHOLDER_TENANT_ID__",
    "ClientId": "__PLACEHOLDER_CLIENT_ID__",
    "ClientSecret": "__PLACEHOLDER_CLIENT_SECRET__",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "MicrosoftGraph": {
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "Scopes": "Tasks.ReadWrite User.Read"
  }
}
